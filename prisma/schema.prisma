generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  publicId        String?   @unique // random string
  name            String    @unique
  email           String    @unique
  password        String
  isBlocked       Boolean   @default(false)
  role            String    @default("user")
  isEmailVerified Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  posts                 Post[]              @relation("CreatedPosts")
  imageId               Int?                @unique
  image                 Image?              @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  groups                MembersOfGroup[]
  profile               Profile?
  reacts                React[]
  comments              Comment[]
  friends               Friends[]           @relation("UserFriends")
  friendedBy            Friends[]           @relation("UserFriendsOf")
  savedPosts            SavedPosts[]
  sessions              LoginSession[]
  requestsJoinToGroup   GroupJoinRequest[]
  notificationsReceived Notifications[]     @relation("NotificationRecipient")
  notificationsSent     Notifications[]     @relation("NotificationActor")
  verificationCode      VerificationCode[]
  postsApproved         Post[]              @relation("PostApprover")
  actor                 GroupJoinRequest[] @relation("GroupJoinRequestActor")
}

model Profile {
  id          Int      @id @default(autoincrement())
  isPrivate   Boolean  @default(false)
  bio         String?
  gender      String?
  dateOfBirth DateTime
  city        String?
  country     String?
  school      String?
  education   String?
  work        String?
  updatedAt   DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Image {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique // random string
  fileName    String
  filePath    String
  orderIndex  Int      @default(1)
  description String?
  createdAt   DateTime @default(now())

  user           User?
  coverGroup     Group?
  post           PostImage[]
  imageInComment Comment[]
}

model Post {
  id           Int       @id @default(autoincrement())
  content      String?
  loveCount    Int       @default(0)
  hahaCount    Int       @default(0)
  eggCount     Int       @default(0)
  wowCount     Int       @default(0)
  sadCount     Int       @default(0)
  angryCount   Int       @default(0)
  commentCount Int       @default(0)
  shareCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isPrivate    Boolean   @default(false)
  deletedAt    DateTime?
  type         String    @default("Normal") // Normal, Share

  userId Int
  author User @relation("CreatedPosts", fields: [userId], references: [id], onDelete: Cascade)

  // العلاقة مع الجروب
  groupId      Int?
  group        Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status       String    @default("Approved")
  approvedById Int?
  approvedBy   User?     @relation("PostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // مشاركة البوست (Share Post)
  parentPostId  Int?
  parentPost    Post?   @relation("RePostRelation", fields: [parentPostId], references: [id], onDelete: SetNull)
  rePosts       Post[]  @relation("RePostRelation")
  commentOnPost String? // رأيك عند مشاركة البوست

  images     PostImage[]
  reacts     React[]
  comments   Comment[]
  savedPosts SavedPosts[]

  // لبوستات جروب معين مرتبة بالأحدث
  @@index([groupId, status, createdAt(sort: Desc)])
  // لبوستات المستخدم معين مرتبة بالأحدث
  @@index([userId, createdAt(sort: Desc)])
  // للأدمن
  @@index([groupId, status])
}

model Group {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  rules              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  canAnyOneWritePost Boolean             @default(true)
  isOpen             Boolean             @default(true) // اي حد يقدر يدخل بدون تقديم طلب 
  isPrivate          Boolean             @default(false) // اي حد يقدر يشوف البوستات 
  // العلاقات
  coverId            Int?                @unique
  cover              Image?              @relation(fields: [coverId], references: [id], onDelete: SetNull)
  posts              Post[]
  members            MembersOfGroup[]
  joinRequests       GroupJoinRequest[]
}

model MembersOfGroup {
  id       Int      @id @default(autoincrement())
  role     String   @default("member")
  joinedAt DateTime @default(now())

  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model React {
  id        Int    @id @default(autoincrement())
  reactType String

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId  Int
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId Int?
  image   Image? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

model Friends {
  id        Int      @id @default(autoincrement())
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   Int
  user     User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId Int
  friend   User @relation("UserFriendsOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model SavedPosts {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
}

model LoginSession {
  id           Int       @id @default(autoincrement())
  refreshToken String    @unique
  createdAt    DateTime  @default(now())
  expireAt     DateTime
  revokedAt    DateTime?
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroupJoinRequest {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  actedAt   DateTime? 
  actedById Int?
  actor     User?     @relation("GroupJoinRequestActor", fields: [actedById], references: [id], onDelete: SetNull)
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending")

  @@unique([groupId, userId])
  @@index([groupId, createdAt(sort: Desc)])
	@@map("GroupJoinRequests")
}

model Notifications {
  id         Int      @id @default(autoincrement())
  actionType String // LIKE, COMMENT, FRIEND_REQUEST, GROUP_ACCEPT,.....
  entityType String // POST, COMMENT, USER, GROUP
  entityId   Int // الـ ID بتاع البوست أو الكومنت أو الجروب
  content    String? // اختياري: لو حابب تخزن نص جاهز
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     Int
  actor       User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model PostImage {
  id      Int   @id @default(autoincrement())
  postId  Int
  post    Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageId Int
  image   Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  code      String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
